<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageReleaseNotes>
      - Only support net 8+
    </PackageReleaseNotes>
    <Version>2.0.2.8</Version>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <Title>Fanex.NAP.SignIn</Title>
    <Description>Lightweight sign in component for all NAP sites</Description>
    <Copyright>NexDev</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ONEbook.UM" Version="3.2.4" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\Fanex.NAP.Client\Fanex.NAP.Client.csproj" />
  </ItemGroup>
 

</Project>